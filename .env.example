# Copier ce fichier en ".env" et adapter les valeurs.

# Clé secrète Django - à générer et garder confidentielle en production
# (générer par ex. avec : python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=cle-de-developpement-a-changer-en-production

# True en développement, False en production
DJANGO_DEBUG=True

# Domaines/IP autorisés à servir l'application, séparés par des virgules
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
